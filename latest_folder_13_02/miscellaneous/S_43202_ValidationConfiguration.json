    "Query": [
      {
        "Id": 19085,
        "Query_Name": "Mssql_complex sql",
        "qeryid1": 19085,
        "Profile_Id": 278,
        "LevelOne_Id": null,
        "LevelTwo_Id": null,
        "LevelThree_Id": null,
        "Query_Type": false,
        "Query_Text": "SELECT \n    c.c_name,\n    c.c_nationkey,\n    o.o_orderkey,\n    l.l_orderkey,\n    l.l_partkey,\n    l.l_quantity,\n    l.l_discount,\n    l.l_extendedprice,\n    s.s_name,\n    p.p_name,\n    r.r_name,\n    n.n_name,\n    SUM(l.l_extendedprice * (1 - l.l_discount)) OVER (PARTITION BY c.c_custkey) AS customer_revenue,\n    ROW_NUMBER() OVER (PARTITION BY c.c_custkey ORDER BY l.l_extendedprice DESC) AS line_rank\nFROM tpch_1.dbo.lineitem l\nJOIN tpch_1.dbo.orders o ON l.l_orderkey = o.o_orderkey\nJOIN tpch_1.dbo.customer c ON o.o_custkey = c.c_custkey\nJOIN tpch_1.dbo.supplier s ON l.l_suppkey = s.s_suppkey\nJOIN tpch_1.dbo.part p ON l.l_partkey = p.p_partkey\nJOIN tpch_1.dbo.nation n ON c.c_nationkey = n.n_nationkey\nJOIN tpch_1.dbo.region r ON n.n_regionkey = r.r_regionkey\nWHERE l.l_quantity BETWEEN 15 AND 30\n  AND l.l_discount BETWEEN 0.03 AND 0.08\n  AND l.l_extendedprice > 50000\n  AND p.p_size < 40\n  AND p.p_type LIKE '%COPPER%'\n  AND r.r_name IN ('ASIA', 'EUROPE', 'AMERICA')\nORDER BY customer_revenue DESC",
        "Query_Modified_Text": null,
        "Queryfor_Edit": null,
        "Parallel_Processor_Count": 1,
        "Split_By_Column": null,
