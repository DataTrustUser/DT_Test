    "Query": [
      {
        "Id": 1750,
        "Profile_Id": 2409,
        "Query_Name": "QC",
        "Query_Type": false,
        "Query_Text": "SELECT \n       B.[customer_id],\n       B.[customer_name],\n       B.[address],\n       B.[country],\n       B.[contact_number],\n       B.[email],\n       C.[order_id],\n       C.[order_date],\n       C.[status],\n       CAST(C.[total_amount] AS DECIMAL(18,2)) AS total_amount,\n       D.[product_name],\n       D.[category],\n       D.[unit_price],\n       F.[return_id],\n       F.[product_id],\n       F.[reason],\n       F.[return_date],\n       CAST(F.[refund_amount] AS DECIMAL(18,2)) AS refund_amount\nFROM   (\n        SELECT [customer_id],\n               [customer_name],\n               [address],\n               [country],\n               [contact_number],\n               [email]\n        FROM   [Supplychain_raw].[dbo].[raw_customers]\n       ) AS B\nINNER JOIN (\n        SELECT [order_id],\n               [customer_id],\n               [order_date],\n               [status],\n               [total_amount]\n        FROM   [Supplychain_raw].[dbo].[raw_orders]\n       ) AS C\n    ON B.[customer_id] = C.[customer_id]\nINNER JOIN (\n        SELECT [return_id],\n               [order_id],\n               [product_id],\n               [reason],\n               [return_date],\n               [refund_amount]\n        FROM   [Supplychain_raw].[dbo].[raw_returns]\n       ) AS F\n    ON C.[order_id] = F.[order_id]\nINNER JOIN (\n        SELECT [product_id] AS [product_id2],\n               [product_name],\n               [category],\n               [unit_price]\n        FROM   [Supplychain_raw].[dbo].[raw_products]\n       ) AS D\n    ON F.[product_id] = D.[product_id2];",
        "Query_Modified_Text": null,
        "Queryfor_Edit": null,
        "Parallel_Processor_Count": 1,
        "Split_By_Column": null,
        "IsforVariableBuilder": null,
