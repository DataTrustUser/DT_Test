    "Query": [
      {
        "Id": 137,
        "Profile_Id": 104,
        "Query_Name": "Airlines_Staff_info",
        "Query_Type": false,
        "Query_Text": "SELECT \n    B.\"IDNUM2\",\n    B.\"SEX\",\n    B.\"JOBCODE\",\n    B.\"SALARY\",\n    B.\"BIRTH\",\n    B.\"HIRED\",\n    D.\"CITY\",\n    D.\"STATE\",\n    D.\"HPHONE\",\n    D.\"FNAME\" + ' ' + D.\"LNAME\" AS \"full_name\",\n    DATEDIFF(YEAR, B.\"BIRTH\", GETDATE()) \n        - CASE \n            WHEN MONTH(GETDATE()) < MONTH(B.\"BIRTH\") \n                 OR (MONTH(GETDATE()) = MONTH(B.\"BIRTH\") AND DAY(GETDATE()) < DAY(B.\"BIRTH\")) \n            THEN 1 \n            ELSE 0 \n          END AS \"age\"\nFROM \n    (SELECT \n         \"IDNUM\" AS \"IDNUM2\",\n         \"SEX\",\n         \"JOBCODE\",\n         \"SALARY\",\n         \"BIRTH\",\n         \"HIRED\"\n     FROM \"Airline_Data\".\"dbo\".\"Staff_Table\") B\nINNER JOIN \n    (SELECT \n         \"IDNUM\",\n         \"LNAME\",\n         \"FNAME\",\n         \"CITY\",\n         \"STATE\",\n         \"HPHONE\"\n     FROM \"Airline_Data\".\"dbo\".\"Staff_Table2\") D\nON \n    (B.\"IDNUM2\" = D.\"IDNUM\");",
